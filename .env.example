# Cache directory
CACHE_DIR=.cache

# Concurrency settings
MAX_CONCURRENT_REQUESTS=5

# Web search settings (if using paid API)
# SERPAPI_KEY=your_api_key_here

# Gemini API (used for web-based organisation classification)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_RETRIES=4
# GEMINI_BACKOFF_BASE_SECONDS=1.5
# GEMINI_BACKOFF_MAX_SECONDS=20
# GEMINI_MIN_INTERVAL_SECONDS=1.2

# OpenAI API fallback (used when Gemini is unavailable / rate-limited)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_RETRIES=3
# OPENAI_BACKOFF_BASE_SECONDS=1.5
# OPENAI_BACKOFF_MAX_SECONDS=20
# OPENAI_MIN_INTERVAL_SECONDS=1.2
