# Cache directory
CACHE_DIR=.cache

# Concurrency settings
MAX_CONCURRENT_REQUESTS=5

# Gemini API (used for web-based organisation classification)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_RETRIES=4
# GEMINI_BACKOFF_BASE_SECONDS=1.5
# GEMINI_BACKOFF_MAX_SECONDS=20
# GEMINI_MIN_INTERVAL_SECONDS=1.2
# GEMINI_USE_URL_CONTEXT=false
# Optional comma-separated list of URLs to provide as URL-context to Gemini
# GEMINI_URL_CONTEXT_URLS=https://example.org,https://example.com
GEMINI_USE_GOOGLE_SEARCH_GROUNDING=false
GEMINI_MEDIA_RESOLUTION=low
GEMINI_THINKING_LEVEL=low
GEMINI_USE_STRUCTURED_OUTPUT=false
# Optional: override the default JSON Schema used to request structured output from Gemini.
# GEMINI_STRUCTURED_OUTPUT_SCHEMA={"type":"object","properties":{"legal_form":{"type":"string"},"src":{"type":"string"}},"required":[]}

# OpenAI API fallback (used when Gemini is unavailable / rate-limited)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5-nano
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_RETRIES=3
# OPENAI_BACKOFF_BASE_SECONDS=1.5
# OPENAI_BACKOFF_MAX_SECONDS=20
# OPENAI_MIN_INTERVAL_SECONDS=20
# OPENAI_MAX_COMPLETION_TOKENS=120
# OPENAI_WAIT_FOR_CAPACITY_WINDOW=true
# OPENAI_QUOTA_SAFETY_MARGIN=0.9
# OPENAI_REQUESTS_PER_MINUTE=3
# OPENAI_TOKENS_PER_MINUTE=40000
# OPENAI_REQUESTS_PER_DAY=200
# OPENAI_TOKENS_PER_DAY=200000
